    <worksheet name='What-If'>
      <layout-options>
        <title>
          <formatted-text>
            <run>What if analysis of Avg Delivery Delay vs Projected Delay</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset.csv+ (Multiple Connections)' name='federated.1fl9bug02wtby516u96090xlcwx5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Improvement_Percentage' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='30.'>
              <calculation class='tableau' formula='30.' />
              <range granularity='10.0' max='50.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fl9bug02wtby516u96090xlcwx5'>
            <column caption='Delivery Delay' datatype='integer' default-format='n#,##0.0' name='[Calculation_0179556292681731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])' />
            </column>
            <column caption='Delivery Delay (Numeric)' datatype='integer' name='[Calculation_1124037638520834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0179556292681731]' />
            </column>
            <column caption='Projected_Delay' datatype='real' name='[Calculation_1124037644656650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1124037638520834] * (1 - [Parameters].[Parameter 1] / 100)' />
            </column>
            <column-instance column='[Calculation_0179556292681731]' derivation='Avg' name='[avg:Calculation_0179556292681731:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1124037644656650]' derivation='Avg' name='[avg:Calculation_1124037644656650:qk]' pivot='key' type='quantitative' />
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1fl9bug02wtby516u96090xlcwx5].[avg:Calculation_0179556292681731:qk]' included-values='non-null' />
          <filter class='categorical' column='[federated.1fl9bug02wtby516u96090xlcwx5].[none:order_status:nk]'>
            <groupfilter function='member' level='[none:order_status:nk]' member='&quot;delivered&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
