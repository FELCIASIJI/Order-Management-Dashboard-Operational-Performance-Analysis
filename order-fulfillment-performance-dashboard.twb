      <aliases enabled='yes' />
      <column caption='Delivery Status' datatype='string' name='[Calculation_0179556290478080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date]) THEN &quot;Not Delivered&quot;&#13;&#10;ELSE &quot;Delivered&quot;&#13;&#10;END' />
      </column>
      <column caption='Valid Order' datatype='string' name='[Calculation_0179556291211265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status] = &quot;canceled&quot; THEN &quot;No&quot;&#13;&#10;ELSE &quot;Yes&quot;&#13;&#10;END' />
      </column>
      <column caption='Delivery Time' datatype='integer' name='[Calculation_0179556292124674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_customer_date])' />
      </column>
      <column caption='Delivery Delay' datatype='integer' default-format='n#,##0.0' name='[Calculation_0179556292681731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])' />
      </column>
      <column caption='Clean Delivery Time' datatype='integer' name='[Calculation_0179556292829188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_status] = &quot;delivered&quot; THEN&#13;&#10;DATEDIFF(&apos;day&apos;,[order_purchase_timestamp],[order_delivered_customer_date])&#13;&#10;END' />
      </column>
      <column caption='Performance Category' datatype='string' name='[Calculation_0179556303306757]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0179556292681731] &lt; -5 THEN &quot;Very Fast&quot;&#13;&#10;ELSEIF [Calculation_0179556292681731] &lt; 0 THEN &quot;Fast&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Delivered Orders %' datatype='real' default-format='p0.00%' name='[Calculation_0179556309012486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [order_status] = &quot;delivered&quot; THEN [order_id] END)&#13;&#10;/ COUNT([order_id])' />
      </column>
      <column caption='Cancellation Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0179556309741575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [order_status] = &quot;canceled&quot; THEN [order_id] END)&#13;&#10;/ COUNT([order_id])' />
      </column>
      <column caption='On-Time %' datatype='real' default-format='p0.00%' name='[Calculation_0179556309901320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Calculation_0179556292681731] &lt;= 0 THEN [order_id] END)&#13;&#10;/ COUNT([order_id])' />
      </column>
      <column caption='Fullfillment  Breakdown' datatype='string' name='[Calculation_0179556418875409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status] = &quot;delivered&quot; THEN &quot;Good&quot;&#13;&#10;ELSEIF [order_status] = &quot;canceled&quot; OR [order_status] = &quot;unavailable&quot; THEN &quot;Bad&quot;&#13;&#10;ELSE &quot;Neutral&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Delivery Delay Fixed' datatype='integer' name='[Calculation_0289507966922753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_0179556292681731])' />
      </column>
      <column caption='Delivery Delay (Numeric)' datatype='integer' name='[Calculation_1124037638520834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0179556292681731]' />
      </column>
      <column caption='Projected_Delay' datatype='real' name='[Calculation_1124037644656650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1124037638520834] * (1 - [Parameters].[Parameter 1] / 100)' />
